@model List<Event>
@{
    ViewData["Title"] = "Events";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">Manage the events shown on your public timeline.</p>
    <a href="/Admin/Events/Create" class="btn btn-signal btn-sm"><i class="bi bi-plus-lg"></i> Add event</a>
</div>

<div class="admin-card p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="ps-3">Title</th>
                <th>Date</th>
                <th>Location</th>
                <th>Featured</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td class="ps-3">@e.Title</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Location</td>
                    <td>@(e.IsFeatured ? "Yes" : "No")</td>
                    <td class="text-end pe-3">
                        <a href="/Admin/Events/Edit/@e.EventId" class="btn btn-sm btn-outline-dark"><i class="bi bi-pencil"></i></a>
                        <a href="/Admin/Events/Delete/@e.EventId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No events yet. Add your first one.</td></tr>
            }
        </tbody>
    </table>
</div>
