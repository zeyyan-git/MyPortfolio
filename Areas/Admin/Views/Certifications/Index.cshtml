@model List<Certification>
@{
    ViewData["Title"] = "Certifications";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">Manage the certifications shown on your public timeline.</p>
    <a href="/Admin/Certifications/Create" class="btn btn-signal btn-sm"><i class="bi bi-plus-lg"></i> Add certification</a>
</div>

<div class="admin-card p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="ps-3">Title</th>
                <th>Issuer</th>
                <th>Issue Date</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="ps-3">@c.Title</td>
                    <td>@c.IssuingOrganization</td>
                    <td>@c.IssueDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end pe-3">
                        <a href="/Admin/Certifications/Edit/@c.CertificationId" class="btn btn-sm btn-outline-dark"><i class="bi bi-pencil"></i></a>
                        <a href="/Admin/Certifications/Delete/@c.CertificationId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No certifications yet. Add your first one.</td></tr>
            }
        </tbody>
    </table>
</div>
