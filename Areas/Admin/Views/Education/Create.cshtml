@model Education
@{
    ViewData["Title"] = "Add Education";
}
<div class="admin-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Degree" class="form-label"></label>
            <input asp-for="Degree" class="form-control" />
            <span asp-validation-for="Degree" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Institution" class="form-label"></label>
            <input asp-for="Institution" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsCurrent" class="form-check-input" />
            <label asp-for="IsCurrent" class="form-check-label"></label>
        </div>
        <div class="mb-3">
            <label asp-for="Details" class="form-label"></label>
            <input asp-for="Details" class="form-control" placeholder="e.g. CGPA: 3.3, or Marks: 906/1100" />
        </div>
        <button type="submit" class="btn btn-signal">Save education</button>
        <a href="/Admin/Education" class="btn btn-outline-dark">Cancel</a>
    </form>
</div>
