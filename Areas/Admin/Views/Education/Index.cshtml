@model List<Education>
@{
    ViewData["Title"] = "Education";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">Manage the education history shown on your public timeline.</p>
    <a href="/Admin/Education/Create" class="btn btn-signal btn-sm"><i class="bi bi-plus-lg"></i> Add education</a>
</div>

<div class="admin-card p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th class="ps-3">Degree</th>
                <th>Institution</th>
                <th>Duration</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td class="ps-3">@e.Degree</td>
                    <td>@e.Institution</td>
                    <td>@e.StartDate.ToString("MMM yyyy") — @(e.IsCurrent ? "Present" : e.EndDate?.ToString("MMM yyyy") ?? "—")</td>
                    <td class="text-end pe-3">
                        <a href="/Admin/Education/Edit/@e.EducationId" class="btn btn-sm btn-outline-dark"><i class="bi bi-pencil"></i></a>
                        <a href="/Admin/Education/Delete/@e.EducationId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No education added yet. Add your first one.</td></tr>
            }
        </tbody>
    </table>
</div>
